<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      Section 6.6.4 Narrow Suppression:
      The AI Studio container environment provides pre-installed Gradle 9.3.1 (/opt/gradle) and an offline Maven cache
      containing AGP 9.1.1. Upgrading AGP to 9.3.x/9.5.0 or Gradle Wrapper to 9.5.0/9.8.2 is incompatible with the
      container's fixed Gradle 9.3.1 binary and offline Maven repository. This narrow path rule suppresses
      AndroidGradlePluginVersion strictly on gradle-wrapper.properties and libs.versions.toml.
    -->
    <issue id="AndroidGradlePluginVersion">
        <ignore path="**/gradle-wrapper.properties" />
        <ignore path="**/libs.versions.toml" />
    </issue>
</lint>
